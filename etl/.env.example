# MODELO de variaveis de ambiente.
# Copie este arquivo para um novo chamado ".env" e preencha os valores reais.
# O arquivo ".env" NUNCA vai para o Git (esta no .gitignore), pois guarda senhas.
#
# Estes dados serao usados na ETAPA FUTURA, quando o script for gravar os dados
# limpos no banco PostgreSQL + PostGIS (que rodara dentro do Docker).

PGHOST=localhost
PGPORT=5432
PGDATABASE=seguranca_sjc
PGUSER=postgres
PGPASSWORD=troque_esta_senha
