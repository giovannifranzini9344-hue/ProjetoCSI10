# Credenciais do banco PostGIS.
# Sao usadas TANTO pelo docker-compose (para criar o banco) QUANTO pelo
# script de carga em Node (etl/src/load.ts), para se conectar nele.
#
# Copie este arquivo para ".env" (na mesma pasta "infra") e ajuste a senha.
# O arquivo ".env" NUNCA vai para o Git (esta no .gitignore).

POSTGRES_USER=csi10
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=seguranca_sjc
POSTGRES_PORT=5432
PGHOST=localhost
